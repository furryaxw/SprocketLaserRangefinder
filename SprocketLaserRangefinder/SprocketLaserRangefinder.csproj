<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SprocketLaserRangefinder</AssemblyName>
    <RootNamespace>SprocketLaserRangefinder</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.3.0</AssemblyVersion>
    <FileVersion>0.1.3.0</FileVersion>
    <Description>Depth-based laser rangefinder and automatic ballistic elevation for Sprocket.</Description>
    <Authors>Axw_0</Authors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/furryaxw/SprocketLaserRangefinder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/furryaxw/SprocketLaserRangefinder.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == '' and '$(SPROCKET_GAME_ROOT)' != ''">$(SPROCKET_GAME_ROOT)</SprocketGameRoot>
    <SprocketGameRoot Condition="'$(SprocketGameRoot)' == ''">G:\Sprocket0.2.55.5</SprocketGameRoot>
    <BepInExCore>$(SprocketGameRoot)\BepInEx\core</BepInExCore>
    <GameInterop>$(SprocketGameRoot)\BepInEx\interop</GameInterop>
    <ModLibraryDirectory Condition="'$(ModLibraryDirectory)' == ''">$(SprocketGameRoot)\BepInEx\plugins</ModLibraryDirectory>
    <ModDeployDirectory Condition="'$(ModDeployDirectory)' == ''">$(SprocketGameRoot)\BepInEx\plugins</ModDeployDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SprocketModAPI">
      <HintPath>$(ModLibraryDirectory)\SprocketModAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SprocketDepth">
      <HintPath>$(ModLibraryDirectory)\SprocketDepth.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(BepInExCore)\BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameInterop)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(GameInterop)\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameInterop)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameInterop)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameInterop)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameInterop)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime">
      <HintPath>$(GameInterop)\Unity.RenderPipelines.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime">
      <HintPath>$(GameInterop)\Unity.RenderPipelines.HighDefinition.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.DamageModelFramework">
      <HintPath>$(GameInterop)\Sprocket.DamageModelFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Core">
      <HintPath>$(GameInterop)\Sprocket.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Blueprints">
      <HintPath>$(GameInterop)\Sprocket.Blueprints.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Projectiles">
      <HintPath>$(GameInterop)\Sprocket.Projectiles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.VehicleControl">
      <HintPath>$(GameInterop)\Sprocket.VehicleControl.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.VehicleController">
      <HintPath>$(GameInterop)\Sprocket.VehicleController.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.VehicleFramework">
      <HintPath>$(GameInterop)\Sprocket.VehicleFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.CrewTasks">
      <HintPath>$(GameInterop)\Sprocket.CrewTasks.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Vehicles.Cannons">
      <HintPath>$(GameInterop)\Sprocket.Vehicles.Cannons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.Vehicles.Weapons">
      <HintPath>$(GameInterop)\Sprocket.Vehicles.Weapons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.LayingDriveDesigner">
      <HintPath>$(GameInterop)\Sprocket.LayingDriveDesigner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sprocket.WeaponFramework">
      <HintPath>$(GameInterop)\Sprocket.WeaponFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild"
          AfterTargets="PostBuildEvent"
          Condition="'$(SkipModDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDirectory)" />
  </Target>

</Project>
